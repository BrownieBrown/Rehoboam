# The blanket Python "lib/" rule above (venv site-packages) also matches any
# directory literally named "lib" anywhere in the tree, which shadows the
# Next.js app's own web/src/lib/ — un-ignore it explicitly.
!web/src/lib/
!web/src/lib/**
.serena/

# Bicep compiled ARM templates
deploy/bicep/**/*.json

# SDD workspace (scratch — git history is the record)
.superpowers/
deploy/bicep/main.json
